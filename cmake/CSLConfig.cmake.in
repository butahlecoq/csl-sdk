@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@CSL_ENABLE_CASADI@)
  find_dependency(casadi CONFIG)
endif()
if(@CSL_ENABLE_IPOPT@)
  block(SCOPE_FOR VARIABLES)
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(Ipopt 3.14.19 EXACT MODULE)
  endblock()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CSLTargets.cmake")
check_required_components(CSL)
