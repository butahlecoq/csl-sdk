@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@CSL_ENABLE_CASADI@)
  find_dependency(casadi CONFIG)
endif()
if(@CSL_ENABLE_IPOPT@)
  block(SCOPE_FOR VARIABLES PROPAGATE Ipopt_FOUND)
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_package(Ipopt 3.14.19 EXACT MODULE QUIET)
  endblock()
  if(NOT Ipopt_FOUND)
    set(CSL_FOUND FALSE)
    set(CSL_NOT_FOUND_MESSAGE "The installed CSL Ipopt provider requires Ipopt 3.14.19.")
    return()
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CSLTargets.cmake")
check_required_components(CSL)
